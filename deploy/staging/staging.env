# Staging's compose variables (docker compose --env-file deploy/staging/staging.env): read INSTEAD of the production
# `.env`, so nothing of production's configuration reaches staging. Settings only, never a secret (secrets are files in
# deploy/staging/secrets/). Names and purposes: docs/operations.md, "Staging and the deploy gate".
TZ=UTC
# The Kalshi DEMO key file inside the container (deploy/staging/keys/ is mounted at /keys), e.g. /keys/demo.pem;
# empty = no Sandbox mode, Shadow only.
BTCFLOW_TRADING_DEMO_KEY_PATH=
# An OTLP endpoint for staging's telemetry (empty = none exported).
SETTLEVIEW_STAGING_OTLP_ENDPOINT=
