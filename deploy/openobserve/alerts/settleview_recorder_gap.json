{
  "name": "settleview_recorder_gap",
  "stream_type": "metrics",
  "stream_name": "settleview_recorder_longest_gap",
  "is_real_time": false,
  "query_condition": {
    "type": "sql",
    "sql": "SELECT recorder, max(value) AS v FROM \"settleview_recorder_longest_gap\" GROUP BY recorder HAVING max(value) >= 30"
  },
  "trigger_condition": {
    "period": 30,
    "operator": ">=",
    "threshold": 1,
    "frequency": 15,
    "frequency_type": "minutes",
    "silence": 30,
    "align_time": true
  },
  "destinations": [
    "settleview_telegram_warning"
  ],
  "notify_on_recovery": true,
  "recovery_destinations": [
    "settleview_telegram_resolved"
  ],
  "row_template": "{recorder}: {v} min",
  "row_template_type": "String",
  "description": "Long gap in research recording (30+ min in the last 24 h).",
  "context_attributes": {
    "severity": "warning",
    "slo": "No recording gap of 30 min or more per 24 h.",
    "runbook": "https://github.com/jon-lange/settleview/blob/main/docs/operations.md#alert-recorder-coverage"
  },
  "enabled": true
}
