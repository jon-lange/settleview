{
  "name": "settleview_loop_restarts",
  "stream_type": "metrics",
  "stream_name": "settleview_loop_restarts",
  "is_real_time": false,
  "query_condition": {
    "type": "sql",
    "sql": "SELECT loop, max(value) - min(value) AS n FROM \"settleview_loop_restarts\" GROUP BY loop HAVING max(value) > min(value)"
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "frequency_type": "minutes",
    "silence": 30,
    "align_time": true
  },
  "destinations": [
    "settleview_telegram_warning"
  ],
  "notify_on_recovery": true,
  "recovery_destinations": [
    "settleview_telegram_resolved"
  ],
  "row_template": "{loop}: {n}",
  "row_template_type": "String",
  "description": "An app background loop keeps restarting.",
  "context_attributes": {
    "severity": "warning",
    "slo": "No supervised loop restart per 15 min.",
    "runbook": "https://github.com/jon-lange/settleview/blob/main/docs/operations.md#alert-restarts"
  },
  "enabled": true
}
