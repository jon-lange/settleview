{
  "name": "settleview_writer_backlog",
  "stream_type": "metrics",
  "stream_name": "settleview_writer_pending",
  "is_real_time": false,
  "query_condition": {
    "type": "sql",
    "sql": "SELECT min(value) AS v FROM \"settleview_writer_pending\" HAVING min(value) >= 5000"
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "frequency_type": "minutes",
    "silence": 30,
    "align_time": true
  },
  "destinations": [
    "settleview_telegram_warning"
  ],
  "notify_on_recovery": true,
  "recovery_destinations": [
    "settleview_telegram_resolved"
  ],
  "row_template": "{v} writes queued",
  "row_template_type": "String",
  "description": "Database writes backing up (5,000+ queued for 5 min).",
  "context_attributes": {
    "severity": "warning",
    "slo": "Under 5,000 queued writes.",
    "runbook": "https://github.com/jon-lange/settleview/blob/main/docs/operations.md#alert-writer"
  },
  "enabled": true
}
