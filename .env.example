# Copy to .env and adjust. Every setting is optional; defaults shown.
BTCFLOW_DB_PATH=data/btcflow.db
BTCFLOW_PREDICTION_HORIZONS={"1m":60,"5m":300,"15m":900}
BTCFLOW_TIE_POLICY=kalshi
BTCFLOW_BACKFILL_DAYS=30
BTCFLOW_KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
BTCFLOW_KALSHI_SERIES=KXBTC15M
BTCFLOW_KALSHI_FEE_RATE=0.07
BTCFLOW_MAX_ACTIVE_PER_HORIZON=5
BTCFLOW_API_HOST=127.0.0.1
BTCFLOW_API_PORT=8000
# Optional PC listener (Docker; compose.yaml sets it): the only port where a browser paired with `ops pair-pc` is this
# PC (no PIN); without the pairing cookie it shows only "Pair this browser". Must differ from BTCFLOW_API_PORT; publish
# it on 127.0.0.1 only, never in the cloud (docs/operations.md, "Running in Docker: who counts as the PC").
# BTCFLOW_PC_PORT=8001
# BTCFLOW_PC_HOST=127.0.0.1
# Optional listener for external agents (MCP): the tool API only, every call with a live session's token; never the PC.
# Unset = external agents cannot call tools. Publish on 127.0.0.1 only (compose.yaml sets both).
# BTCFLOW_AGENT_PORT=
# BTCFLOW_AGENT_HOST=
# The address phones open (http://<this PC's LAN address>:8000, no path): shown on the Phone access card and allowed
# as a Host. Set it under Docker, where the app cannot see the host's LAN address.
# BTCFLOW_PUBLIC_URL=
BTCFLOW_WORKERS=1
# Optional read-only Kalshi account link: Play's Kalshi balance (create an API key at kalshi.com; keep the .pem private)
# BTCFLOW_KALSHI_KEY_ID=
# BTCFLOW_KALSHI_PRIVATE_KEY_PATH=C:/Users/you/.kalshi/btcflow.pem
# Kalshi BTC perpetuals (the Perps tab). Off by default; uses the trading keys above (BTCFLOW_TRADING_*_KEY_*).
# Trades from the primary perps account (subaccount 0): the whole perps balance backs a position.
# Production perps (perp_prod) also need BTCFLOW_TRADING_ENABLED=true and the production trading key.
# BTCFLOW_PERPS_ENABLED=false
# BTCFLOW_PERPS_PROTECTIVE_BAND=0.005
# BTCFLOW_PERPS_WARN_AMBER=0.05
# BTCFLOW_PERPS_WARN_RED=0.02
# BTCFLOW_PERPS_ORDER_HARD_CEILING=2000
# Agent mode: an AI agent trades inside sessions you start from the app, on your own Anthropic API key
# (console.anthropic.com). Off by default; the key is never shown in the app.
# BTCFLOW_AGENT_ENABLED=false
# BTCFLOW_ANTHROPIC_API_KEY=
# The Claude Code CLI the in-app agent runs on (Claude Agent SDK; one process per wake). Empty = the CLI bundled with
# claude-agent-sdk, else `claude` on PATH. Set it where pip installs no bundled CLI (Windows ARM64) or to pin a build.
# BTCFLOW_AGENT_CLI_PATH=
# Agent sessions on venues in production (real money). Off by default.
# BTCFLOW_AGENT_ALLOW_PRODUCTION=false
# Extra inherited environment variables the agent's CLI may keep (a proxy, a CA bundle), comma-separated names;
# ANTHROPIC_* / CLAUDE_* / BTCFLOW_* are refused.
# BTCFLOW_AGENT_ENV_PASS=
# Telegram remote (one bot, one user): the token from @BotFather. Empty = the bot is off. Long polling only (no inbound
# port); pair it from the PC's Agent tab with a one-time code. Never shown in the app or logged.
# BTCFLOW_TELEGRAM_BOT_TOKEN=
# The bot's @username for the pairing instruction. Optional: the app reads it from Telegram (getMe) once the bot runs.
# BTCFLOW_TELEGRAM_BOT_USERNAME=
# Research recorders (python -m btc_signal_engine.recorders): where they write polymarket_us.db and where the app reads
# their freshness. Default: a "research" folder next to the database.
# BTCFLOW_RESEARCH_DIR=data/research
# The app's own rotating log file under <db dir>/logs (containers turn it off and log to stderr only).
# BTCFLOW_FILE_LOG=true
# The httpx / httpcore loggers' level (WARNING by default; INFO logs one line per request).
# BTCFLOW_HTTP_CLIENT_LOG_LEVEL=WARNING
# Any setting can also come from a file: BTCFLOW_<NAME>_FILE=/run/secrets/<name> (Docker / Swarm secrets). An empty
# file means "not configured". Under Docker compose every key above (Polymarket key id and secret, Anthropic key,
# Telegram token, Kalshi key ids) is such a file in ./secrets, never a line here: compose sets the _FILE variables, and
# a key in both places stops the start. Move existing ones once: python deploy/secrets_from_env.py
# Docker only: the phone port's host address (default 0.0.0.0). On a Linux server use the LAN address or 127.0.0.1:
# Docker's published ports bypass ufw / firewalld.
# BTCFLOW_PHONE_BIND=0.0.0.0
# Postgres instead of the SQLite file at BTCFLOW_DB_PATH (compose.yaml sets these for its services; names only here).
# The URL carries no password (postgresql://settleview_app@host:5432/settleview); the password comes from its own
# setting, normally a secret file. Install the driver with: pip install -e ".[postgres]"
# BTCFLOW_DATABASE_URL=
# BTCFLOW_DATABASE_PASSWORD_FILE=
# Research scripts' read-only connection (the settleview_research role); unset = they read the SQLite files read-only.
# BTCFLOW_RESEARCH_DATABASE_URL=
# BTCFLOW_RESEARCH_DATABASE_PASSWORD_FILE=
# Postgres connection limits (milliseconds, 0 = none): statement, lock and idle-in-transaction timeouts; the long
# statement timeout of migrations, bulk moves and research scripts; the wait for a pooled connection (seconds).
# BTCFLOW_DB_STATEMENT_TIMEOUT_MS=5000
# BTCFLOW_DB_LOCK_TIMEOUT_MS=2000
# BTCFLOW_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# BTCFLOW_DB_LONG_STATEMENT_TIMEOUT_MS=600000
# BTCFLOW_DB_POOL_TIMEOUT_S=5

# Docker only: your IANA time zone for the local day (Record, daily summary). Default UTC.
# TZ=

# OpenTelemetry (docs/operations.md, "Observability"): off while the endpoint is empty. Names only; the backend's
# credential goes in the file secrets/otlp_headers (compose sets OTEL_EXPORTER_OTLP_HEADERS_FILE), never here.
# Local OpenObserve (docker compose --profile observability up -d): http://openobserve:5080/api/default
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_RESOURCE_ATTRIBUTES=
# OTEL_TRACES_SAMPLER_ARG=
# OTEL_METRIC_EXPORT_INTERVAL=
# OTEL_TRACES_EXPORTER=
# OTEL_METRICS_EXPORTER=
# OTEL_LOGS_EXPORTER=
# OTEL_SDK_DISABLED=
